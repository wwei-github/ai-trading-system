# ============================================================
# 后端运行模式（影响：数据库 / 缓存选择）
#   local  : 本地开发 → SQLite + 内存缓存，无需 Docker
#   docker : Docker Compose → PostgreSQL + Redis
#   online : 线上部署 → PostgreSQL + Redis（运维配置完整地址）
# ============================================================
RUN_MODE=

# ========== 应用配置 ==========
# 应用名称
APP_NAME=AI Trading System
# 运行环境: development / staging / production
APP_ENV=development
# 调试模式: true / false
DEBUG=true
# API 路由前缀
API_PREFIX=/api/v1
# CORS 允许的前端来源 (JSON 数组格式或逗号分隔)
# local: 5173  docker: 38000
CORS_ORIGINS=["http://localhost:5173","http://localhost:38000"]

# ========== 数据库配置 ==========
# RUN_MODE=local 时自动回退 SQLite，不必修改；
# RUN_MODE=docker/online 时填写真实 PostgreSQL 地址。
DATABASE_URL=postgresql+asyncpg://user:password@localhost:15432/trading
# 连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ========== Redis 配置 ==========
# Redis 连接地址 (缓存 / Celery 消息队列 / 结果后端)
# RUN_MODE=local 时不强制要求，代码会自动降级。
REDIS_URL=redis://localhost:16379/0

# ========== 安全配置 ==========
# JWT 签名密钥 (生产环境务必更换为随机长字符串)
SECRET_KEY=
# AES-256 加密密钥 (任意字符串，将通过 SHA-256 派生 Fernet 密钥，
# 用于加密 API Key 等敏感数据；生产环境务必更换)
ENCRYPTION_KEY=

# ========== Stage 1: JWT 鉴权 ==========
# JWT 专用密钥（留空回退到 SECRET_KEY）
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# Access Token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh Token 有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=7
# 记住我时长（天）
REMEMBER_ME_DAYS=30
# 连续登录失败次数上限
LOGIN_ATTEMPT_MAX=5
# 锁定时长（分钟）
LOGIN_LOCK_MINUTES=30

# ========== Stage 1: 邮件 SMTP ==========
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_FROM=noreply@trading.local
# 测试模式=true 时不实际发送，仅控制台打印
EMAIL_TEST_MODE=true
# 前端 URL（用于邮件内链接）
APP_URL=http://localhost:38000

# ========== Stage 1: 限流 ==========
RATE_LIMIT_ENABLED=false
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_TRADE_PER_MIN=30
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=3

# ========== 默认用户配置 ==========
# 无登录流程场景下的默认用户 ID (UUID 格式)
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_EMAIL=admin@trading-system.dev
DEFAULT_USER_NICKNAME=Trader

# ========== 文件上传配置 ==========
# 上传文件保存目录
UPLOAD_DIR=uploads
# 最大上传大小 (字节)，默认 50MB
MAX_UPLOAD_SIZE=52428800

# ========== LLM 配置（已废弃，请通过系统设置页面管理）==========
# 此配置仅用于启动时首次迁移到 DB，迁移后不再生效
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=2000

# ========== Embedding 配置（已废弃，请通过系统设置页面管理）==========
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# ========== 交易所代理配置 ==========
# 交易所 API 请求代理地址（大陆需配置才能访问 Binance 等境外交易所）
# 留空则不使用代理，直接连接交易所 API
# 本地开发: http://127.0.0.1:7890（Clash/V2Ray 等本地代理端口）
# Docker 部署: 由 docker-compose 自动设为 http://proxy:8888
EXCHANGE_PROXY=

# ========== Docker 代理上游配置 ==========
# 仅 Docker 部署时有效，指向上游代理（用户自有的 Shadowsocks/V2Ray/Clash 等）
# 留空则 tinyproxy 直连目标服务器（仅海外服务器可用）
PROXY_UPSTREAM=
