# 应用名称
APP_NAME=AI Trading System
# 运行环境: development / staging / production
APP_ENV=development
# 调试模式: true / false
DEBUG=true
# PostgreSQL 数据库连接地址 (asyncpg 异步驱动)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/trading
# Redis 连接地址 (缓存 / Celery 消息队列)
REDIS_URL=redis://localhost:6380/0
# JWT 签名密钥 (生产环境务必更换为随机长字符串)
SECRET_KEY=
# AES-256 加密密钥 (32 字节十六进制，用于加密 API Key 等敏感数据)
ENCRYPTION_KEY=
# API 路由前缀
API_PREFIX=/api/v1
# CORS 允许的前端来源 (JSON 数组格式)
CORS_ORIGINS=["http://localhost:5173"]
