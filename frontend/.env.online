# ============================================================
# 模式：online（远程线上模式）
# 数据来源：已部署的线上服务器（公网或内网 IP）
# 启动命令：npm run dev:online
# ============================================================
# 说明：此模式有两种 API 调用方式
#   方式 A (VITE_USE_PROXY=true)：仍然走 Vite 代理（/api/v1 -> 线上地址）
#       优点：无跨域问题，与 local/docker 体验一致
#       缺点：本地 Vite 作为中转代理，多一跳
#   方式 B (VITE_USE_PROXY=false)：直接跨域调用线上完整地址
#       优点：少一跳，请求直达线上
#       缺点：需要线上后端开启 CORS 允许 http://localhost:5173
# ============================================================

# 是否通过 Vite 代理转发（默认 true 推荐，避免 CORS 问题）
VITE_USE_PROXY=true

# 后端 API 完整基础 URL（当 VITE_USE_PROXY=false 时使用完整地址）
VITE_API_BASE_URL=/api/v1

# 后端线上服务器完整地址（含端口）
VITE_API_ONLINE_URL=https://your-server.example.com:18000

# WebSocket 连接地址（线上服务器）
VITE_WS_URL=wss://your-server.example.com:18000

# Vite 代理目标地址（线上服务器完整地址）
VITE_PROXY_TARGET=https://your-server.example.com:18000

# 应用标题
VITE_APP_TITLE=AI 智能交易管理系统（线上模式）

# 当前运行模式
VITE_RUN_MODE=online
