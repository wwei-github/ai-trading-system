# ============================================================
# 模式模板：local（本地开发模式 - 默认）
# 使用说明：复制本文件为 .env.local，按需要修改字段值
# 数据来源：本地 Python 后端服务 (uvicorn) + 本地 SQLite
# 启动命令：npm run dev (默认即 --mode local)
# ============================================================

# 后端 API 基础路径（通过 Vite 代理转发到本地后端服务，一般无需修改）
VITE_API_BASE_URL=/api/v1

# WebSocket 连接地址（行情推送 / 实时通知）
# 本地后端默认监听 8000
VITE_WS_URL=ws://localhost:8000

# Vite 代理目标地址（本地后端 uvicorn 默认端口）
VITE_PROXY_TARGET=http://localhost:8000

# 应用标题（显示在浏览器标签页与页头，可自定义）
VITE_APP_TITLE=AI 智能交易管理系统（本地模式）

# 当前运行模式（local / docker / online），仅用于调试与 UI 展示徽章
VITE_RUN_MODE=local
