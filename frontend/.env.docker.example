# ============================================================
# 模式模板：docker（Docker 容器模式）
# 使用说明：复制本文件为 .env.docker
# 前置条件：项目根目录执行 docker-compose up -d 启动全部容器
# 启动命令：npm run dev:docker
# 数据来源：Docker Compose 启动的 PostgreSQL + Redis + FastAPI + Celery
# ============================================================

# 后端 API 基础路径（通过 Vite 代理转发到 Docker 暴露的端口，一般无需修改）
VITE_API_BASE_URL=/api/v1

# WebSocket 连接地址（Docker 容器映射到本机的端口）
# 需与 docker-compose.yml 中 backend ports 映射一致
VITE_WS_URL=ws://localhost:18000

# Vite 代理目标地址（Docker 后端容器映射到本机的端口）
VITE_PROXY_TARGET=http://localhost:18000

# 应用标题
VITE_APP_TITLE=AI 智能交易管理系统（Docker 模式）

# 当前运行模式
VITE_RUN_MODE=docker
