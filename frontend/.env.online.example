# ============================================================
# 模式模板：online（远程线上模式）
# 使用说明：复制本文件为 .env.online，替换为真实线上地址
# 启动命令：npm run dev:online
# ============================================================
# 此模式 API 调用两种方式：
#   方式 A (VITE_USE_PROXY=true)：仍然走 Vite 代理（/api/v1 -> 线上地址）
#       优点：无跨域问题，与 local/docker 体验一致；默认推荐
#       缺点：本地 Vite 作为中转代理，多一跳
#   方式 B (VITE_USE_PROXY=false)：直接跨域调用线上完整 URL
#       优点：少一跳，请求直达线上
#       缺点：需要线上后端开启 CORS 允许 http://localhost:5173
# ============================================================

# 是否通过 Vite 代理转发（默认 true 推荐，避免 CORS 问题）
VITE_USE_PROXY=true

# 后端 API 基础路径
# 方式 A: 保持 /api/v1 相对路径
# 方式 B: 仍保留 /api/v1，真正的 host 在下方 VITE_API_ONLINE_URL 拼接
VITE_API_BASE_URL=/api/v1

# 后端线上服务器完整地址（含协议 + host + 端口）
# 方式 A: 作为 Vite 代理的 target
# 方式 B: 作为 baseURL 的前缀，直接跨域调用
# 示例: https://your-server.example.com:18000
VITE_API_ONLINE_URL=

# WebSocket 连接地址（线上服务器）
# 示例: wss://your-server.example.com:18000
VITE_WS_URL=

# Vite 代理目标地址（线上服务器完整地址；通常 = VITE_API_ONLINE_URL）
VITE_PROXY_TARGET=

# 应用标题
VITE_APP_TITLE=AI 智能交易管理系统（线上模式）

# 当前运行模式
VITE_RUN_MODE=online
