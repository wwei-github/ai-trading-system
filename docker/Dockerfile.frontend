# 前端构建阶段
FROM node:20-alpine AS builder

WORKDIR /app

# 复制依赖文件
COPY frontend/package*.json ./

# 安装依赖
RUN npm ci

# 复制源码
COPY frontend/ ./

# 构建时注入生产环境变量（Docker 内前端通过 nginx 反代 /api/ 到 backend 容器）
ENV VITE_API_BASE_URL=/api/v1
ENV VITE_WS_URL=ws://localhost:18000
ENV VITE_APP_TITLE="AI 智能交易管理系统"
ENV VITE_RUN_MODE=docker

# 构建
RUN npm run build

# 生产阶段
FROM nginx:alpine

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制 nginx 配置
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
